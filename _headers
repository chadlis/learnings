# En-têtes Cloudflare Pages. Ce fichier est consommé par Pages, pas servi.

# Le service worker ne doit jamais être servi depuis un cache périmé :
# c'est lui qui décide de la fraîcheur de tout le reste.
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# L'index est régénéré à chaque fiche ajoutée : toujours revalider.
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache, must-revalidate

# Les fiches n'ont pas de nom versionné : revalidation systématique, le cache
# hors ligne est assuré par le service worker, pas par le cache HTTP.
/fiches/*
  Cache-Control: public, max-age=0, must-revalidate
/timeline-formation.html
  Cache-Control: public, max-age=0, must-revalidate

# Les icônes changent rarement.
/icone-fiches.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
